        {
          "type": "emphasis",
          "children": [
            {
              "type": "text",
              "text": "回复前验证两次"
            }
          ]
        },
        {
          "type": "text",
          "text": "”这样的指令，常常会被前沿模型按字面意思执行，从而浪费 token。"
        }
      ]
    },
    "b040": {
      "status": "translated",
      "inlines": [
        {
          "type": "strong",
          "children": [
            {
              "type": "text",
              "text": "彻底性与强调类增强表述"
            }
