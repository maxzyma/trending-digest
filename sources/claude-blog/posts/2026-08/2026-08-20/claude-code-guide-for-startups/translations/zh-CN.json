            }
          ]
        },
        {
          "type": "text",
          "text": " · "
        },
        {
          "type": "link",
          "attrs": {
            "url": "https://omni.co/"
          },
          "children": [
            {
              "type": "text",
              "text": "Omni"
            }
          ]
        },
        {
          "type": "text",
          "text": " 联合创始人兼 CTO"
