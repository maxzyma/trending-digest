                      }
                    ]
                  }
                ]
              },
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": " "
                  }
                ]
              },
              {
                "type": "text",
                "text": "built AI Teammates, collaborative AI agents that work alongside humans inside Asana projects, taking on tasks and drafting deliverables. The team used Managed Agents to add advanced features dramatically faster than they would have been able to otherwise."
              }
            ]
          },
          {
