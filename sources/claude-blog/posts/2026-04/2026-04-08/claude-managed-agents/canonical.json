                },
                "children": [
                  {
                    "type": "strong",
                    "children": [
                      {
                        "type": "text",
                        "text": "Rakuten"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "text",
                "text": " shipped enterprise agents across product, sales, marketing and finance that plug into Slack and Teams, letting employees assign tasks and get back deliverables like spreadsheets, slides, and apps. Each specialist agent was deployed within a week."
              }
            ]
          },
          {
            "id": "b024",
            "type": "list_item",
            "inlines": [
              {
