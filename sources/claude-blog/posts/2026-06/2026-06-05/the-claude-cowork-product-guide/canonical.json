            "type": "list_item",
            "inlines": [
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "A product matrix for understanding when to use what tool:"
                  }
                ]
              },
              {
                "type": "text",
                "text": " chat for conversational drafting, Claude Code for coding, and Claude Cowork for cross-app knowledge work"
              }
            ]
