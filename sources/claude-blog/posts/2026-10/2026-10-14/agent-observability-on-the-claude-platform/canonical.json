                  }
                ]
              },
              {
                "type": "text",
                "text": ", "
              },
              {
                "type": "link",
                "attrs": {
                  "url": "https://docs.langchain.com/langsmith/trace-anthropic"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "LangSmith by LangChain"
                  }
                ]
              },
              {
                "type": "text",
                "text": ", "
              },
              {
                "type": "link",
                "attrs": {
                  "url": "https://newrelic.com/blog/news/anthropic-otel-ai-observability"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "New Relic"
                  }
                ]
              },
              {
                "type": "text",
                "text": ", and "
              },
              {
                "type": "link",
                "attrs": {
                  "url": "https://posthog.com/docs/ai-observability/installation/anthropic?tab=Claude+Platform&utm_source=anthropic&utm_campaign=anthropic-otel"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "PostHog"
                  }
                ]
              },
              {
                "type": "text",
                "text": ", you can turn real traces into evals, catch quality issues, and measure whether a change helped."
              }
            ]
          },
          {
            "id": "b010",
            "type": "list_item",
            "inlines": [
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "text": "Track usage across your organization"
                  }
                ]
              },
              {
                "type": "text",
                "text": ". Send traces to "
              },
              {
                "type": "link",
                "attrs": {
                  "url": "https://docs.databricks.com/aws/en/ai-gateway/unified-trace-table"
                },
                "children": [
                  {
                    "type": "text",
                    "text": "Databricks Unity Gateway"
                  }
                ]
              },
              {
                "type": "text",
                "text": " so platform and security teams can see token usage by team and flag unusual activity."
              }
            ]
          }
        ]
      },
      {
        "id": "b012",
        "type": "paragraph",
        "inlines": [
          {
            "type": "text",
            "text": "Claude traces also work with any other OpenTelemetry tool that accepts a standard OTLP endpoint."
          }
        ]
      },
      {
        "id": "b013",
        "type": "heading",
        "inlines": [
          {
            "type": "text",
            "text": "Get started"
          }
        ],
        "attrs": {
          "level": 2
        }
      },
      {
        "id": "b014",
        "type": "paragraph",
        "inlines": [
          {
            "type": "text",
            "text": "OpenTelemetry traces on the Claude Platform is available in public beta. Managed Agents and the Messages API need a destination in the Claude Console, while Claude SDKs export traces automatically. "
          }
        ]
      },
      {
        "id": "b015",
        "type": "paragraph",
        "inlines": [
          {
            "type": "text",
            "text": "See the "
          },
          {
            "type": "link",
            "attrs": {
              "url": "https://platform.claude.com/docs/en/manage-claude/opentelemetry"
            },
            "children": [
              {
                "type": "text",
                "text": "docs"
              }
            ]
          },
          {
            "type": "text",
            "text": " to get started."
          }
        ]
      }
